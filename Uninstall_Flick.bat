@echo off
title Uninstalling Flick...
echo Stopping Flick processes...
taskkill /F /IM Flick.exe 2>nul
echo Removing shortcuts...
del /F /Q "%USERPROFILE%\Desktop\Flick.lnk" 2>nul
del /F /Q "%USERPROFILE%\OneDrive\Desktop\Flick.lnk" 2>nul
del /F /Q "%APPDATA%\Microsoft\Windows\Start Menu\Programs\Flick.lnk" 2>nul
echo Removing startup entry...
reg delete "HKCU\Software\Microsoft\Windows\CurrentVersion\Run" /v "Flick" /f 2>nul
echo Removing program files...
rd /S /Q "%LOCALAPPDATA%\Programs\Flick" 2>nul
echo.
echo Flick has been completely removed from your PC.
pause
